---
// src/components/medium/Hero.astro
import { Button } from "@/components/ui/button";
---

<header class="bg-[#FFC017] border-b border-black md:pt-32 pt-24 pb-20 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-6 md:px-12 grid md:grid-cols-2 gap-12 items-center relative z-10">
    <div class="space-y-8 animate-in fade-in slide-in-from-left duration-1000">
      <h1 class="text-7xl md:text-[6.5rem] font-serif leading-[0.9] tracking-tight">Stay curious.</h1>
      <p class="text-2xl leading-relaxed max-w-md text-black/80">
        Discover stories, thinking, and expertise from writers on any topic.
      </p>
      <Button client:load size="lg" className="bg-black text-white hover:bg-black/80 rounded-full px-10 text-xl py-7 h-auto">
        Start reading
      </Button>
    </div>
    
    <div class="hidden md:flex justify-end transform translate-x-12 translate-y-8 select-none pointer-events-none opacity-20">
      <div class="text-[20rem] font-serif font-bold leading-none select-none text-black">M</div>
    </div>
  </div>
</header>
