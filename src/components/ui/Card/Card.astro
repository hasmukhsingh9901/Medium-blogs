---
// src/components/ui/Card/Card.astro
import './Card.css';
import Button from '../Button/Button.tsx';

interface Props {
	title: string;
	description: string;
	buttonText?: string;
	buttonHref?: string;
}

const { title, description, buttonText, buttonHref } = Astro.props;
---

<div class="card">
	<h2>{title}</h2>
	<p>{description}</p>
	{buttonText && (
		<div class="card-footer">
			<Button client:load text={buttonText} href={buttonHref} />
		</div>
	)}
</div>
