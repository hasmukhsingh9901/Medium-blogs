---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '@/components/medium/Navbar';
import Hero from '@/components/medium/Hero.astro';
import PostCard from '@/components/medium/PostCard';
import Sidebar from '@/components/medium/Sidebar';

const posts = [
  {
    author: "Elena Rossi",
    avatar: "https://i.pravatar.cc/150?u=elena",
    title: "The Silent Architecture of Minimalist Living",
    excerpt: "Why removing the clutter from your physical space is only the first step toward mental clarity and creative freedom in an noisy world.",
    date: "Feb 18",
    readTime: "8 min read",
    image: "https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1000&auto=format&fit=crop"
  },
  {
    author: "Julian Thorne",
    avatar: "https://i.pravatar.cc/150?u=julian",
    title: "AI and the Myth of Human Exclusivity",
    excerpt: "Examining the philosophical boundaries between algorithmic processing and human intuition in the age of generative models.",
    date: "Feb 15",
    readTime: "12 min read",
    image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?q=80&w=1000&auto=format&fit=crop"
  },
  {
    author: "Sarah Jenkins",
    avatar: "https://i.pravatar.cc/150?u=sarah",
    title: "Deep Work: The Only Way to Win in 2024",
    excerpt: "Mastering the skill of intense focus is no longer a luxury—it's the primary differentiator for high-performing professionals.",
    date: "Feb 10",
    readTime: "6 min read",
    image: "https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?q=80&w=1000&auto=format&fit=crop"
  }
];
---

<Layout>
	<Navbar client:load />
	<Hero />
	
	<main class="max-w-7xl mx-auto px-6 md:px-12 py-16 grid lg:grid-cols-12 gap-16">
		<div class="lg:col-span-8 space-y-2">
			{posts.map(post => (
				<PostCard client:load {...post} />
			))}
		</div>
		
		<div class="lg:col-span-4">
			<Sidebar client:load />
		</div>
	</main>
</Layout>

<style is:global>
  /* Smoothing transitions between sections */
  main {
    animation: fadeIn 0.8s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
